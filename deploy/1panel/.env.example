# Copy to conf/petcare.env on the server and chmod 600. Never commit the real file.
PETCARE_ROOT=/opt/1panel/apps/petcare
POSTGRES_DB=petcare

# Generate each independently: openssl rand -base64 48
POSTGRES_SUPERUSER_PASSWORD=REPLACE_ME
PETCARE_MIGRATOR_PASSWORD=REPLACE_ME
PETCARE_CORE_DB_PASSWORD=REPLACE_ME
PETCARE_AI_DB_PASSWORD=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME
JWT_SECRET_KEY=REPLACE_ME
SA_TOKEN_JWT_SECRET_KEY=REPLACE_ME
INTERNAL_SERVICE_TOKEN=REPLACE_ME

# Generate once and never change after Kafka has data:
# docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=REPLACE_ME

DEEPSEEK_API_KEY=REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=REPLACE_ME
ZHIPUAI_API_KEY=REPLACE_ME

OSS_ENDPOINT=REPLACE_ME
OSS_ACCESS_KEY_ID=REPLACE_ME
OSS_ACCESS_KEY_SECRET=REPLACE_ME
OSS_BUCKET_NAME=REPLACE_ME

# This deployment is intentionally protected by site-wide Basic Auth.
AUTH_DEMO_ENABLED=true
