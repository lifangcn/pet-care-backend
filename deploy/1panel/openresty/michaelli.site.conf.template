# Paste this snippet inside the HTTPS server block managed by 1Panel.
# Let 1Panel keep listen/certificate/ACME directives and the HTTP->HTTPS redirect.
    root /www/sites/michaelli.site/index;
    index index.html;
    client_max_body_size 11m;

    # Protect the demo UI and login bootstrap endpoints. Business API locations
    # disable Basic Auth because the application uses the Authorization header
    # for its own Bearer token.
    auth_basic "PetCare restricted demo";
    auth_basic_user_file /www/sites/michaelli.site/.htpasswd;

    location ^~ /api/admin/ai/ { return 404; }
    location ^~ /api/internal/ { return 404; }
    location ^~ /api/actuator/ { return 404; }

    location = /api/auth/refresh {
        auth_basic off;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://petcare-core:8080;
        proxy_http_version 1.1;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/auth/logout {
        auth_basic off;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://petcare-core:8080;
        proxy_http_version 1.1;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/auth/ {
        rewrite ^/api(/.*)$ $1 break;
        proxy_set_header Authorization "";
        proxy_pass http://petcare-core:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/ai/chat/ {
        auth_basic off;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://petcare-ai:8081;
        proxy_http_version 1.1;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        add_header X-Accel-Buffering no;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        access_log off;
    }

    location = /api/reminder/sse-connect {
        auth_basic off;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://petcare-core:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        add_header X-Accel-Buffering no;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        access_log off;
    }

    location ^~ /api/ai/ {
        auth_basic off;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://petcare-ai:8081;
        proxy_http_version 1.1;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 15s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ^~ /api/ {
        auth_basic off;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://petcare-core:8080;
        proxy_http_version 1.1;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 15s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }

    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
